# 이 파일을 terraform.tfvars 로 복사해서 값을 채운다 (terraform.tfvars 는 .gitignore 로 커밋되지 않음)
#   cp terraform.tfvars.example terraform.tfvars

# 내 공인 IP (SSH, 443 허용). 확인: curl https://checkip.amazonaws.com
admin_cidr = "x.x.x.x/32"

# RDS 마스터 비밀번호
db_password = ""

# RDS 시작/종료 알림을 보낼 Discord 웹훅 URL
discord_webhook_url = ""

# log EC2 의 Redis 비밀번호 (12자 이상, 영문/숫자와 # _ - . @ + = : 만 가능). 생성: openssl rand -hex 16
redis_password = ""

# web 서버 도메인 (DNS A 레코드가 web EIP 를 가리켜야 함)
domain = "test.oogachaka.co.kr"

# Let's Encrypt 인증서 발급/만료 알림 이메일
cert_email = "you@example.com"
